# Copy to .env and fill in.  cp .env.example .env

# ── LLM (Claude is the default analysis + report engine) ─────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-opus-4-8

# OpenAI — used for game SNAPSHOT image generation (Step 3). Also lets you
# switch the text engine to OpenAI via LLM_PROVIDER=openai.
OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o
# OPENAI_IMAGE_MODEL=gpt-image-1     # or dall-e-3
# OPENAI_IMAGE_SIZE=1024x1536        # portrait (matches LuchaDog)

# ── Reddit ───────────────────────────────────────────────────────────────────
# Reddit now 403s keyless requests, so add a FREE key to scrape it:
#   reddit.com/prefs/apps → "create app" → type: script → copy the id + secret.
# (Leave blank to try the keyless path; it may be blocked.)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AIEngineScraper/1.0

# ── Optional extra sources (skipped automatically if left blank) ─────────────
# YouTube Data API v3 — free: console.cloud.google.com → enable API → API key
YOUTUBE_API_KEY=
# Twitch app — free: dev.twitch.tv/console/apps → create app
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# RAWG game database — free: rawg.io/apidocs → sign up → copy key
RAWG_API_KEY=
