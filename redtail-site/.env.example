# Copy to .env (or set in Vercel project env vars).
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_IMAGE_MODEL=gpt-image-1
# Login gate for the Lore page
LORE_PASSWORD=redtaillore@2026
# Second permanent account (co-founders) — same full access, separate credential.
LORE_ADMIN_PASSWORD=redtailadmin@2026
# Third permanent account (Dakota) — same full access, separate credential.
LORE_DAKOTA_PASSWORD=dakotaredtail@2026
# Fourth permanent account (Andres Sevilla) — same full access, separate credential.
LORE_ANDRES_PASSWORD=andresredtail@2026
# External partner account (Caravela Capital) — username "caravelacapital".
LORE_CARAVELA_PASSWORD=7ghlZU1IB9hOo1JzyveK
# Time-boxed guest login — expires on its own. Set deliberately.
LORE_GUEST_PASSWORD=loreguest@2026
LORE_GUEST_EXPIRES=2027-12-31T23:59:59+00:00
# Gates the Competition workspace's document-grounded AI analysis (genre fit,
# player-experience topics, redesign briefs) — set to 1 to allow uploaded
# game design text + catalog metadata to reach the configured LLM provider.
LORE_ALLOW_DOCUMENT_AI=1
# Optional override for the redesign concept-image model (must be a
# gpt-image-* model — falls back to OPENAI_IMAGE_MODEL above).
OPENAI_REDESIGN_MODEL=gpt-image-1
